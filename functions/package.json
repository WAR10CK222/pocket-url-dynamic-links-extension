{
    "name": "functions",
    "scripts": {
        "lint": "eslint \"src/**/*\"",
        "lint:fix": "eslint \"src/**/*\" --fix",
        "serve": "ts-node -r tsconfig-paths/register src/app.ts",
        "build:dev": "npx tsc --project tsconfig.json && tscpaths -p tsconfig.json -s ./src -o ./lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "mocha": "mocha '**/*.spec.ts'",
        "test": "(cd integration-tests && firebase emulators:exec 'npm run mocha' -P demo-test)"
    },
    "main": "lib/index.js",
    "dependencies": {
        "dotenv": "^17.0.1",
        "express": "^5.1.0",
        "fast-geoip": "^1.1.88",
        "firebase-admin": "^12.6.0",
        "firebase-functions": "^6.0.1",
        "isbot": "^5.1.28",
        "moment": "^2.30.1",
        "object-hash": "^3.0.0",
        "tsconfig-paths": "^4.2.0",
        "tscpaths": "^0.0.9",
        "useragent": "^2.3.0"
    },
    "devDependencies": {
        "@types/chai": "^4.3.4",
        "@types/mocha": "^10.0.1",
        "@types/object-hash": "^3.0.6",
        "@types/useragent": "^2.3.4",
        "@typescript-eslint/eslint-plugin": "^5.12.0",
        "@typescript-eslint/parser": "^5.12.0",
        "axios": "^1.10.0",
        "chai": "^4.3.7",
        "eslint": "^8.15.1",
        "eslint-config-google": "^0.14.0",
        "eslint-plugin-import": "^2.26.0",
        "mocha": "^10.2.0",
        "ts-node": "^10.4.0",
        "typescript": "^4.9.0"
    },
    "private": true
}