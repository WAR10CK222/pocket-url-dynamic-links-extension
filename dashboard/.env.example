# Local development against the emulators (copy to .env.local).
# Functions emulator URL of the api function; /api requests are proxied there.
VITE_API_PROXY=http://127.0.0.1:5001/demo-pocket-url/us-central1/api
# Auth emulator, and the Firebase config Hosting would normally serve at /__/firebase/init.json.
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_PROJECT_ID=demo-pocket-url
VITE_SITE_NAME=Demo
VITE_SHORT_DOMAIN=demo-links.web.app
